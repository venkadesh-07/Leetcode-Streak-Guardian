# LeetCode Streak Guardian - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Flask Secret Key (Required)
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_hex_string

# Supabase / PostgreSQL Database URL (Required)
# Copy from Supabase Dashboard -> Connect -> URI (or automatically set on Render)
DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Telegram Bot Token (Optional for Telegram Alerts)
# Create a bot with @BotFather on Telegram to obtain this token.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# WhatsApp Alerts (CallMeBot)
# Users configure their own Phone Number and CallMeBot API Key directly in the web UI Settings.
# No global server API key is required!

# Public Base URL of your deployed app (used in email links)
# Set this to your Render/production URL so email links work correctly.
# APP_BASE_URL=https://your-app-name.onrender.com

# Email Delivery Configuration (Option A: Brevo HTTPS API - Recommended for Render free tier)
# 300 free emails/day to ANY recipient over HTTPS (Port 443). Never blocked by Render!
# Get your free key at: https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# REMINDER_SENDER_EMAIL=your_verified_sender_email@gmail.com
# REMINDER_SENDER_NAME=LeetCode Streak Guardian

# Email Delivery Configuration (Option B: Traditional SMTP - for GitHub Actions / Local)
# Note: Render Free Tier blocks outbound SMTP (ports 587/465). Use Brevo above on Render.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_USE_TLS=true

